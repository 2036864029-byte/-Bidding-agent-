# DeepSeek LLM（推理 + 路由）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# Tavily（联网检索，可选）
TAVILY_API_KEY=

# MinerU（PDF 解析）
MINERU_API_TOKEN=

# SiliconFlow（BGE-m3 embedding + BGE reranker）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=

# Embedding（若不走 SiliconFlow 则填其他服务）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# MySQL（业务数据库 ztb_clean）
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_CLEAN_DB=

# Milvus（向量库）
MILVUS_HOST=
MILVUS_PORT=
# 云托管 Milvus（阿里云 Milvus 版 / Zilliz Cloud）用下面两项，URI 一旦非空则 host/port 失效：
#   MILVUS_URI=https://in03-xxxxxxxx.serverless.<region>.zillizcloud.com
#   MILVUS_TOKEN=<user:password 或 API Key>
# 留空 = 回退 MILVUS_HOST:MILVUS_PORT（本地 docker 容器，行为不变）
MILVUS_URI=
MILVUS_TOKEN=
# ── 后端档位：一个开关决定「连本地还是连云」──
# 留空 / local / milvus → 自建容器（dense 索引默认 HNSW）
# cloud                → 云托管（dense 索引默认 AUTOINDEX，与云端迁移生成的集合一致）
# ⚠ 除「连接 + 索引类型」外，集合名 / schema / BM25 三项必须两端一致，否则结果不可比
VECTOR_BACKEND=
# 显式覆盖 dense 索引类型（一般不用设；VECTOR_BACKEND=cloud 已自动为 AUTOINDEX）
# MILVUS_DENSE_INDEX_TYPE=AUTOINDEX
# 集合名（两端必须一致，保证可复现）
MILVUS_COLLECTION=public_kb
# BM25 混合检索（与集合 schema 绑定，两端一致）
# ⚠ 依赖服务端 BM25 Function + 中文 analyzer（本地栈 v2.6.23）。云托管版本低于 2.5 时
#   要么建集合失败，要么只能置 false —— 置 false = 丢掉 sparse 路，混合检索退化为纯稠密
ENABLE_MILVUS_BM25=true

# Embedding（若不走 SiliconFlow 则填其他服务）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT=60
EMBEDDING_MAX_RETRIES=3

# 分块参数为代码默认（2000/100），两端天然一致，不可经 .env 覆盖。

# ── PDF 解析后端（热切换：改这一行即可，不改代码）──
# local      本地 magic-pdf CLI（MinerUParser）——**默认**，本地开发行为不变
# official   MinerU 官方 API（mineru.net）——云服务器用，本机无需装 MinerU/GPU
# selfhosted 自建 /parse 服务（deploy/mineru/）
PDF_PARSE_BACKEND=local

# MinerU 官方 API（PDF_PARSE_BACKEND=official 时生效；Token 复用下方 MINERU_API_TOKEN）
MINERU_OFFICIAL_BASE_URL=https://mineru.net/api/v4
# pipeline（快）| vlm（准、慢）| MinerU-HTML（仅 html 文件）
MINERU_OFFICIAL_MODEL_VERSION=pipeline
MINERU_OFFICIAL_LANGUAGE=ch
MINERU_OFFICIAL_POLL_INTERVAL=3
MINERU_OFFICIAL_POLL_TIMEOUT=600

# PDF 三档路由（默认关闭=全量 MinerU；交接入库走 markdown/jsonl 不需要开）
PDF_TIERED_ROUTING_ENABLED=false
PDF_TIERED_TWO_COL_CONFIDENCE=0.80
PDF_TIERED_BACKGROUND_IMG_RATIO=0.70
PDF_TIERED_PROFILE_MAX_WORKERS=16
PDF_TIERED_BOOK_TIMEOUT_SEC=3600

# MinerU 远程解析服务（复杂页上云；本地交接入库用不到，导出/增量解析需要）
PDF_PARSE_BASE_URL=
MINERU_API_TOKEN=
MINERU_API_TIMEOUT=3600

# PDF 结构增强（表格原子块/目录过滤/双栏打标）
ENABLE_PDF_STRUCTURE=true
# ── API 鉴权与审计（W3-0）──
# 逗号分隔的 API Key；留空 = 关闭鉴权（本地/内网）。原始 Key 不落任何日志。
API_KEYS=
# 鉴权豁免路径（探活/指标/文档）
AUTH_EXEMPT_PATHS=/health,/metrics,/docs,/openapi.json,/redoc
# 审计日志落盘路径（留空 = 只输出到 audit logger/stderr）
AUDIT_LOG_PATH=
# 审计是否记录用户问题（含企业名等个人信息，截断 120 字符）
AUDIT_LOG_QUESTIONS=true

# ── 会话与记忆（W2-4）──
# memory（进程内，重启丢失）| sqlite | postgres | redis
CHECKPOINTER_BACKEND=sqlite
CHECKPOINTER_SQLITE_PATH=
# 会话空闲过期（秒）；0 = 不过期
SESSION_TTL_SECONDS=86400
SESSION_SWEEP_INTERVAL_SECONDS=300

# ── 上传文件缓存 / 任务状态表（B1）──
# memory（进程内，仅单 worker）| redis（多 worker / 多副本共享）
# ⚠️ API_WORKERS > 1 时两者都必须是 redis，否则上传的文件与任务状态跨 worker
#    不可见（404）。执行仍在提交到的 worker 上跑，共享的只是状态。
FILE_STORE_BACKEND=memory
JOB_QUEUE_BACKEND=memory
# 两个 *_REDIS_URL 留空即复用 CACHE_REDIS_URL（容器里由 compose 覆盖成宿主地址）
FILE_STORE_REDIS_URL=
JOB_QUEUE_REDIS_URL=
FILE_STORE_TTL_SECONDS=3600
JOB_QUEUE_TTL_SECONDS=3600

# ── 入口限流（W2-5）──
# 每客户端每分钟请求数；0 = 关闭
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20

# ── 并发容量（第 2 批 C2/B6）──
# 下面几项代码里已有面向 100 并发的默认值，此处列出仅供按实测调整。
# ⚠️ MAX_INFLIGHT_REQUESTS 与 CHAT_THREAD_LIMIT 必须一起调：同步端点由 anyio
#    线程池代跑（出厂默认 40），线程池 < 闸门就白调闸门。
# MAX_INFLIGHT_REQUESTS=128
# CHAT_THREAD_LIMIT=128
# 价格分支线程池；SQL_POOL 与 MYSQL_POOL_MAX 需同步（池满会等待超时报错）
# QUERY_POOL_MAX_WORKERS=32
# SQL_POOL_MAX_WORKERS=32
# MYSQL_POOL_MAX=32
# 解析进程池（CPU 密集，与请求链路隔离）；服务器 16 核可再上调
# CPU_POOL_WORKERS=8
# 单机 worker 数（>1 时 _BACKEND 必须全为 redis，见上）
# API_WORKERS=2

# ── 内容安全前置（W3-4）──
# 问题长度上限（字符）；超长即拒绝
MAX_QUESTION_CHARS=2000
# 有害执行请求关键词（逗号分隔；留空 = 默认动作导向清单）：
# 只拦「帮我伪造/删掉处罚记录/篡改」类可执行指令，不拦围标串标/行贿受贿等合法话题词
SAFETY_HARMFUL_KEYWORDS=

# ── 可观测 trace（E0-3）──
# 开关与密钥缺一即不启用（dev/test 默认关，零开销、不触网）
ENABLE_TRACING=false
# Langfuse 自托管地址（deploy/langfuse/）；密钥取自该目录 .env 的 LANGFUSE_INIT_PROJECT_*
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
TRACING_SERVICE_NAME=ztb-agent

# ── 飞书通道（入站机器人 + 进度推送）──────────────────────────────
# 入站是**独立进程**：`python -m channels.feishu`（出站 WebSocket 长连接，不开入站端口）
# 总开关为 false 时该进程直接 exit(2) —— 配了 restart 会变成重启循环
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 国内 https://open.feishu.cn；Lark 国际版 https://open.larksuite.com
FEISHU_DOMAIN=https://open.feishu.cn
# OAuth 绑定回调（需与飞书开放平台登记的地址一致）
FEISHU_REDIRECT_URI=
FEISHU_FRONTEND_URL=
FEISHU_OAUTH_SCOPE=contact:user.base:readonly
# 机器人调后端 /chat 的地址。
# ⚠️ 容器内 127.0.0.1 是它自己：Docker 部署必须写 compose 服务名（如 http://api:8000）
FEISHU_BACKEND_BASE_URL=http://127.0.0.1:8000
# 后端开了 API_KEYS 鉴权时，机器人调用要带的 key（留空 = 不带）
FEISHU_BACKEND_API_KEY=
FEISHU_BACKEND_TIMEOUT_S=120
FEISHU_MAX_CONCURRENCY=4
# —— 可观测性（2026-11 新增）——
# 心跳文件：容器健康检查读它判活（留空 = <仓库>/DATA/feishu_heartbeat.json）
FEISHU_HEARTBEAT_PATH=
# Prometheus 抓取端口（独立进程，API 的 /metrics 抓不到它）；0 = 关闭
FEISHU_METRICS_PORT=9100
