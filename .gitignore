# ===== 密钥与环境变量 — 绝对不能提交 =====
.env
.env.local
.env.*.local
# .env 的备份（含真实密钥，勿提交）——注意规则必须单独一行，
# 与注释同行会被 git 当带尾部空格的 pattern，静默失效
.env.bak*
*.pem
*.key
*.secret

# ===== Python 字节码与构建产物 =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
dist/
build/
.eggs/
.venv/
venv/
ENV/

