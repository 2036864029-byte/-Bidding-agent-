# ===== 数据资产 — 团队成员各自获取，不入仓 =====
# 例外：评测金标集（体积小、必须版本化，见 docs/plan1/评测与可观测性/）
DATA/*
!DATA/eval_rag/
raw_pdfs/
new_pdfs/
raw_policy/
raw_tables/
cloud_sync/
*.jsonl
# 例外：评测金标集必须版本化（见 docs/plan1/评测与可观测性/）
!DATA/eval_rag/*.jsonl
# 例外：多轮对话金标集必须版本化（2026-09-16，见 docs/plan1/多轮对话优化执行方案_20260916.md）
!DATA/eval_multiturn/
!DATA/eval_multiturn/*.jsonl

# ===== 本地备份 =====
backup.sql
*.sql.bak
*.dump

# ===== MySQL 容器数据（保留 docker-compose.yml 和 init/01-schema.sql） =====
docker/mysql/mysql_data/
docker/mysql/*.log

# ===== Milvus 容器数据（保留 docker-compose.yml 和启动脚本） =====
milvus/volumes/
milvus/*.log
milvus/etcd-data/

# ===== 测试报告产物（运行后重新生成） =====
test_report/
# ===== Milvus v2.6 POC 栈运行时数据（不入仓） =====
milvus/volumes-v26/

# ===== Claude Code 会话本地脚本（含 SSH 凭证，禁止入库） =====
.claude/

# ===== 数据分析/试点产物（基线脚本、PaddleOCR 模型缓存 2GB+，不入仓） =====
analysis_out/

# ===== 交付包与本地运行时数据卷（成员各自获取 / 运行生成，不入仓） =====
delivery_package/
