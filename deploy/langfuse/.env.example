# ── Langfuse 自托管配置（评测与可观测性执行计划 / E0-2）──────────────
# 用法：cp .env.example .env，替换下方全部空值后 `docker compose up -d`。
# ⚠️ .env 已被 .gitignore 忽略；切勿把真实密钥写进本文件（本文件入库）。

# ── 必改密钥 ──
# 生成方式：openssl rand -hex 32（Windows 可用 python -c "import secrets;print(secrets.token_hex(32))"）
NEXTAUTH_SECRET=
ENCRYPTION_KEY=
SALT=

# ── 数据层凭据 ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_VERSION=17

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=

REDIS_AUTH=

# ── 对象存储（Langfuse 自带 MinIO）──
# 说明：不复用 Milvus 的 MinIO——避免与 Milvus 栈耦合（`docker compose down -v`
# 会连带清空 Langfuse 的 blob）。独立 MinIO 多占约 100MB 内存，换取故障隔离。
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=

# Langfuse 写入 S3 的凭据必须与上面 MINIO_ROOT_* 一致（首次建桶用）
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=

# ── 首次启动自动初始化（E0-3 埋点需要确定的 API Key）──
# 不填则需在 Web 控制台手工建组织/项目/用户，再复制 Key 到 .env
LANGFUSE_INIT_ORG_ID=ztb
LANGFUSE_INIT_ORG_NAME=ztb-demo
LANGFUSE_INIT_PROJECT_ID=ztb-demo
LANGFUSE_INIT_PROJECT_NAME=ztb-demo
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

# ── 其他 ──
NEXTAUTH_URL=http://localhost:3000
# 关闭匿名遥测（内网/合规环境建议 false）
TELEMETRY_ENABLED=false
